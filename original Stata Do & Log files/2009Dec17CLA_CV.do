log using "/Users/claireadida/Desktop/France Documents/March 2009/Analysis/Experiments/CV/AnalysisDec2009.smcl", replace***************************************** Do-file for Analysis of CV Experiment****************************************clearset mem 1guse "/Users/claireadida/Desktop/France Documents/March 2009/Analysis/Experiments/CV/OriginalData.dta"gen MuslimPair=1 if pair=="Paire_Khadija-Aurélie"replace MuslimPair=0 if MuslimPair==.gen ChristianPair=1 if pair=="Paire_Marie-Aurélie"replace ChristianPair=0 if ChristianPair==.gen Secretary=1 if position=="01_Secrétaire"replace Secretary=0 if Secretary==.gen AssistantDirector=1 if position=="02_assistance de direction"replace AssistantDirector=0 if AssistantDirector==.gen AssistantAccountant=1 if position=="03_Aide comptable"replace AssistantAccountant=0 if AssistantAccountant==.gen Accountant=1 if position=="04_Comptable"replace Accountant=0 if Accountant==.gen CDD=1 if contract_type=="CDD"replace CDD=0 if CDD==.gen CDI=1 if contract_type=="CDI"replace CDI=0 if CDI==.gen SmallFirm=1 if firm_size=="01_< 50 salariés"replace SmallFirm=0 if SmallFirm==.replace SmallFirm=. if firm_size==""gen MediumFirm=1 if firm_size=="02_50-249 salariés"replace MediumFirm=0 if MediumFirm==.replace MediumFirm=. if firm_size==""gen LargeFirm=1 if firm_size=="03_>= 250 salariés"replace LargeFirm=0 if LargeFirm==.replace LargeFirm=. if firm_size==""/* Due to some errors in the original coding of the "result" variable, we merge a "newresult" variable withthe following values:missing value if test was not valid due to an email address errorNRNR if both candidates got no responseNRNo if cand1 got no response and cand2 got an explicit noNRYes if cand1 got no response and cand2 got an explicit yesNoNR if cand1 got an explicit no and cand2 got no responseNoNo if both candidates got an explicit noNoYes if cand1 got an explicit no and cand2 got an explicit yesYesNR if cand1 got an explicit yes and cand2 got no responseYesNo if cand1 got an explicit yes and cand2 got an explicit noYesYes if both candidates got an explicit yes */joinby testnumber using "/Users/claireadida/Desktop/France Documents/March 2009/Analysis/Experiments/CV/NewAdidaCoding.dta", _merge(newresultvariableadded)/* There are different ways to interpret and code the data. We do the analysis with all possible codingsFirst, we follow the ISM-Corum interpretation, which is that cases with 2 explicit NO's and cases with 2 NON-ANSWER's (or a mix of the two) are NOT USABLE. According to them, when there are two explicit NO's, it may mean that the 2 CV'swere inadequate for the job. When there are 2 non-answers, it may be that the employer has not even consideredthe CV's: in both cases, these are not real tests. The only usable tests are cases with two explicit YES, andcases with one explicit YES. Note that this version treats as the same result the following two cases:1 explicit yes and 1 non-response; 1 explicit yes and 1 explicit no. Note that in all cases the control candidateis candidate 2 and the test candidate is candidate 1 */codebook newresultgen ControlWins=1 if newresult=="NRYes" | newresult=="NoYes" | newresult=="YesYes"replace ControlWins=0 if ControlWins==.replace ControlWins=. if newresult=="" | newresult=="NRNR" | newresult=="NRNo" | newresult=="NoNR" | newresult=="NoNo"gen TestWins=1 if newresult=="YesNR" | newresult=="YesNo" | newresult=="YesYes"replace TestWins=0 if TestWins==.replace TestWins=. if newresult=="" | newresult=="NRNR" | newresult=="NRNo" | newresult=="NoNR" | newresult=="NoNo"summarize TestWins ControlWinssummarize TestWins ControlWins if MuslimPair==1summarize TestWins ControlWins if ChristianPair==1ttest TestWins, by(MuslimPair) unpaired unequalttest ControlWins, by(MuslimPair) unpaired unequalttest TestWins==ControlWins if ChristianPair==1, unpaired unequalttest TestWins==ControlWins if MuslimPair==1, unpaired unequallogit ControlWins MuslimPair CDD SmallFirm MediumFirm, robustlogit ControlWins MuslimPair CDD SmallFirm MediumFirm test_photo, robustlogit TestWins MuslimPair CDD SmallFirm MediumFirm, robustlogit TestWins MuslimPair CDD SmallFirm MediumFirm test_photo, robustlogit ControlWins MuslimPair CDD SmallFirm MediumFirm Secretary AssistantDirector AssistantAccountant, robustlogit ControlWins MuslimPair CDD SmallFirm MediumFirm Secretary AssistantDirector AssistantAccountant test_photo, robustlogit TestWins MuslimPair CDD SmallFirm MediumFirm Secretary AssistantDirector AssistantAccountant, robustlogit TestWins MuslimPair CDD SmallFirm MediumFirm Secretary AssistantDirector AssistantAccountant test_photo, robustgen interact=MuslimPair*test_photologit ControlWins MuslimPair CDD SmallFirm MediumFirm Secretary AssistantDirector AssistantAccountant test_photo interact, robustlogit TestWins MuslimPair CDD SmallFirm MediumFirm Secretary AssistantDirector AssistantAccountant test_photo interact, robust/* Now we specify an alternative coding, one where we count cases where both get an explicit no as zero's instead of missing dataYet we continue to count NRNR, NRNo, NoNR as missing data (not usable). */gen ControlWins2=1 if newresult=="NRYes" | newresult=="NoYes" | newresult=="YesYes"replace ControlWins2=0 if ControlWins2==.replace ControlWins2=. if newresult=="" | newresult=="NRNR" | newresult=="NRNo" | newresult=="NoNR"gen TestWins2=1 if newresult=="YesNR" | newresult=="YesNo" | newresult=="YesYes"replace TestWins2=0 if TestWins2==.replace TestWins2=. if newresult=="" | newresult=="NRNR" | newresult=="NRNo" | newresult=="NoNR"summarize TestWins2 ControlWins2summarize TestWins2 ControlWins2 if MuslimPair==1summarize TestWins2 ControlWins2 if ChristianPair==1ttest TestWins2, by(MuslimPair) unpaired unequalttest ControlWins2, by(MuslimPair) unpaired unequalttest TestWins2==ControlWins2 if ChristianPair==1, unpaired unequalttest TestWins2==ControlWins2 if MuslimPair==1, unpaired unequallogit ControlWins2 MuslimPair CDD SmallFirm MediumFirm, robustlogit ControlWins2 MuslimPair CDD SmallFirm MediumFirm test_photo, robustlogit TestWins2 MuslimPair CDD SmallFirm MediumFirm, robustlogit TestWins2 MuslimPair CDD SmallFirm MediumFirm test_photo, robustlogit ControlWins2 MuslimPair CDD SmallFirm MediumFirm Secretary AssistantDirector AssistantAccountant, robustlogit ControlWins2 MuslimPair CDD SmallFirm MediumFirm Secretary AssistantDirector AssistantAccountant test_photo, robustlogit TestWins2 MuslimPair CDD SmallFirm MediumFirm Secretary AssistantDirector AssistantAccountant, robustlogit TestWins2 MuslimPair CDD SmallFirm MediumFirm Secretary AssistantDirector AssistantAccountant test_photo, robustlogit ControlWins2 MuslimPair CDD SmallFirm MediumFirm Secretary AssistantDirector AssistantAccountant test_photo interact, robustlogit TestWins2 MuslimPair CDD SmallFirm MediumFirm Secretary AssistantDirector AssistantAccountant test_photo interact, robust/* Finally, we specify one last alternative coding, one where we count all NR and No cases as zeros and keep only as missingdata those invalid tests with email address errors. */gen ControlWins3=1 if newresult=="NRYes" | newresult=="NoYes" | newresult=="YesYes"replace ControlWins3=0 if ControlWins3==.replace ControlWins3=. if newresult==""gen TestWins3=1 if newresult=="YesNR" | newresult=="YesNo" | newresult=="YesYes"replace TestWins3=0 if TestWins3==.replace TestWins3=. if newresult==""summarize TestWins3 ControlWins3summarize TestWins3 ControlWins3 if MuslimPair==1summarize TestWins3 ControlWins3 if ChristianPair==1ttest TestWins3, by(MuslimPair) unpaired unequalttest ControlWins3, by(MuslimPair) unpaired unequalttest TestWins3==ControlWins3 if ChristianPair==1, unpaired unequalttest TestWins3==ControlWins3 if MuslimPair==1, unpaired unequallogit ControlWins3 MuslimPair CDD SmallFirm MediumFirm, robustlogit ControlWins3 MuslimPair CDD SmallFirm MediumFirm test_photo, robustlogit TestWins3 MuslimPair CDD SmallFirm MediumFirm, robustlogit TestWins3 MuslimPair CDD SmallFirm MediumFirm test_photo, robustlogit ControlWins3 MuslimPair CDD SmallFirm MediumFirm Secretary AssistantDirector AssistantAccountant, robustlogit ControlWins3 MuslimPair CDD SmallFirm MediumFirm Secretary AssistantDirector AssistantAccountant test_photo, robustlogit TestWins3 MuslimPair CDD SmallFirm MediumFirm Secretary AssistantDirector AssistantAccountant, robustlogit TestWins3 MuslimPair CDD SmallFirm MediumFirm Secretary AssistantDirector AssistantAccountant test_photo, robustlogit ControlWins3 MuslimPair CDD SmallFirm MediumFirm Secretary AssistantDirector AssistantAccountant test_photo interact, robustlogit TestWins3 MuslimPair CDD SmallFirm MediumFirm Secretary AssistantDirector AssistantAccountant test_photo interact, robustlog close