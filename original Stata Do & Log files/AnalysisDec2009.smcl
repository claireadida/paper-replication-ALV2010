{com}. 
. /* Finally, we specify one last alternative coding, one where we count all NR and No cases as zeros and keep only as missing
> data those invalid tests with email address errors. */
. 
. gen ControlWins3=1 if newresult=="NRYes" | newresult=="NoYes" | newresult=="YesYes"
{txt}(205 missing values generated)

{com}. replace ControlWins3=0 if ControlWins3==.
{txt}(205 real changes made)

{com}. replace ControlWins3=. if newresult==""
{txt}(4 real changes made, 4 to missing)

{com}. 
. gen TestWins3=1 if newresult=="YesNR" | newresult=="YesNo" | newresult=="YesYes"
{txt}(235 missing values generated)

{com}. replace TestWins3=0 if TestWins3==.
{txt}(235 real changes made)

{com}. replace TestWins3=. if newresult==""
{txt}(4 real changes made, 4 to missing)

{com}. 
. summarize TestWins3 ControlWins3

