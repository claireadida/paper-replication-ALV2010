{smcl}
{com}{sf}{ul off}{txt}{.-}       log:  {res}/Users/claireadida/Desktop/France Documents/Datasets/players/Paper 1/CV/CVAnalysisDec2009.smcl  {txt}log type:  {res}smcl {txt}opened on:  {res} 1 Feb 2010, 13:01:55{txt}{com}. . ****************************************. * Do-file for Analysis of CV Experiment. ****************************************. . clear{txt}{com}. set mem 1g{txt}(1048576k){com}. use "/Users/claireadida/Desktop/France Documents/Datasets/players/Paper 1/CV/OriginalData.dta"{txt}{com}. . gen MuslimPair=1 if pair=="Paire_Khadija-Aurélie"{txt}(139 missing values generated){com}. replace MuslimPair=0 if MuslimPair==.{txt}(139 real changes made){com}. . gen ChristianPair=1 if pair=="Paire_Marie-Aurélie"{txt}(136 missing values generated){com}. replace ChristianPair=0 if ChristianPair==.{txt}(136 real changes made){com}. . gen Secretary=1 if position=="01_Secrétaire"{txt}(228 missing values generated){com}. replace Secretary=0 if Secretary==.{txt}(228 real changes made){com}. . gen AssistantDirector=1 if position=="02_Assistante de direction"{txt}(203 missing values generated){com}. replace AssistantDirector=0 if AssistantDirector==.{txt}(203 real changes made){com}. . gen AssistantAccountant=1 if position=="03_Aide comptable"{txt}(196 missing values generated){com}. replace AssistantAccountant=0 if AssistantAccountant==.{txt}(196 real changes made){com}. . gen Accountant=1 if position=="04_Comptable"{txt}(198 missing values generated){com}. replace Accountant=0 if Accountant==.{txt}(198 real changes made){com}. . gen CDD=1 if contract_type=="CDD"{txt}(133 missing values generated){com}. replace CDD=0 if CDD==.{txt}(133 real changes made){com}. . gen CDI=1 if contract_type=="CDI"{txt}(142 missing values generated){com}. replace CDI=0 if CDI==.{txt}(142 real changes made){com}. . gen SmallFirm=1 if firm_size=="01_< 50 salariés"{txt}(90 missing values generated){com}. replace SmallFirm=0 if SmallFirm==.{txt}(90 real changes made){com}. replace SmallFirm=. if firm_size==""{txt}(6 real changes made, 6 to missing){com}. . gen MediumFirm=1 if firm_size=="02_50-249 salariés"{txt}(214 missing values generated){com}. replace MediumFirm=0 if MediumFirm==.{txt}(214 real changes made){com}. replace MediumFirm=. if firm_size==""{txt}(6 real changes made, 6 to missing){com}. . gen LargeFirm=1 if firm_size=="03_>= 250 salariés"{txt}(252 missing values generated){com}. replace LargeFirm=0 if LargeFirm==.{txt}(252 real changes made){com}. replace LargeFirm=. if firm_size==""{txt}(6 real changes made, 6 to missing){com}. . . /* Due to some errors in the original coding of the "result" variable, we merge a "newresult" variable with> the following values:> missing value if test was not valid due to an email address error> NRNR if both candidates got no response> NRNo if cand1 got no response and cand2 got an explicit no> NRYes if cand1 got no response and cand2 got an explicit yes> NoNR if cand1 got an explicit no and cand2 got no response> NoNo if both candidates got an explicit no> NoYes if cand1 got an explicit no and cand2 got an explicit yes> YesNR if cand1 got an explicit yes and cand2 got no response> YesNo if cand1 got an explicit yes and cand2 got an explicit no> YesYes if both candidates got an explicit yes */. . joinby testnumber using "/Users/claireadida/Desktop/France Documents/Datasets/players/Paper 1/CV/NewAdidaCoding.dta", _merge(newresultvariableadded){txt}{com}. . /* There are different ways to interpret and code the data. We do the analysis with all possible codings> First, we follow the ISM-Corum interpretation, which is that cases with 2 explicit NO's and cases with > 2 NON-ANSWER's (or a mix of the two) are NOT USABLE. According to them, when there are two explicit NO's, it may mean that the 2 CV's> were inadequate for the job. When there are 2 non-answers, it may be that the employer has not even considered> the CV's: in both cases, these are not real tests. The only usable tests are cases with two explicit YES, and> cases with one explicit YES. Note that this version treats as the same result the following two cases:> 1 explicit yes and 1 non-response; 1 explicit yes and 1 explicit no. Note that in all cases the control candidate> is candidate 2 and the test candidate is candidate 1 */. . codebook newresult{txt}{hline}{res}newresult{right:(unlabeled)}{txt}{hline}{col 19}type:  string ({res}str9{txt}), but longest is str6{col 10}unique values:  {res}9{col 51}{txt}missing "":  {res}4{txt}/{res}275{txt}{col 13}tabulation:  Freq.  Value{col 24}{res}      4{col 33}""{col 24}    142{col 33}"NRNR"{col 24}      5{col 33}"NRNo"{col 24}     41{col 33}"NRYes"{col 24}      3{col 33}"NoNR"{col 24}     37{col 33}"NoNo"{col 24}      3{col 33}"NoYes"{col 24}     11{col 33}"YesNR"{col 24}      3{col 33}"YesNo"{col 24}     26{col 33}"YesYes"{txt}{com}. . gen ControlWins=1 if newresult=="NRYes" | newresult=="NoYes" | newresult=="YesYes"{txt}(205 missing values generated){com}. replace ControlWins=0 if ControlWins==.{txt}(205 real changes made){com}. replace ControlWins=. if newresult=="" | newresult=="NRNR" | newresult=="NRNo" | newresult=="NoNR" | newresult=="NoNo"{txt}(191 real changes made, 191 to missing){com}. . gen TestWins=1 if newresult=="YesNR" | newresult=="YesNo" | newresult=="YesYes"{txt}(235 missing values generated){com}. replace TestWins=0 if TestWins==.{txt}(235 real changes made){com}. replace TestWins=. if newresult=="" | newresult=="NRNR" | newresult=="NRNo" | newresult=="NoNR" | newresult=="NoNo"{txt}(191 real changes made, 191 to missing){com}. . summarize TestWins ControlWins{txt}    Variable {c |}       Obs        Mean    Std. Dev.       Min        Max{hline 13}{c +}{hline 56}    TestWins {c |}{res}        84    .4761905    .5024324          0          1 {txt}ControlWins {c |}{res}        84    .8333333    .3749163          0          1{txt}{com}. summarize TestWins ControlWins if MuslimPair==1{txt}    Variable {c |}       Obs        Mean    Std. Dev.       Min        Max{hline 13}{c +}{hline 56}    TestWins {c |}{res}        35    .3142857    .4710082          0          1 {txt}ControlWins {c |}{res}        35    .9428571    .2355041          0          1{txt}{com}. summarize TestWins ControlWins if ChristianPair==1{txt}    Variable {c |}       Obs        Mean    Std. Dev.       Min        Max{hline 13}{c +}{hline 56}    TestWins {c |}{res}        49    .5918367     .496587          0          1 {txt}ControlWins {c |}{res}        49     .755102     .434483          0          1{txt}{com}. . ttest TestWins, by(MuslimPair) unpaired unequal{txt}Two-sample t test with unequal variances{hline 9}{c TT}{hline 68}   Group{col 10}{c |}{col 16}Obs{col 27}Mean{col 35}Std. Err.{col 47}Std. Dev.{col 59}[95% Conf. Interval]{hline 9}{c +}{hline 68}       0 {c |}{res}{col 12}     49{col 22} .5918367{col 34}  .070941{col 46}  .496587{col 58} .4492003{col 70} .7344732       {txt}1 {c |}{res}{col 12}     35{col 22} .3142857{col 34} .0796149{col 46} .4710082{col 58} .1524887{col 70} .4760827{txt}{hline 9}{c +}{hline 68}combined {c |}{res}{col 12}     84{col 22} .4761905{col 34} .0548199{col 46} .5024324{col 58}  .367156{col 70}  .585225{txt}{hline 9}{c +}{hline 68}    diff {c |}{res}{col 22}  .277551{col 34} .1066356{col 58} .0651516{col 70} .4899504{txt}{hline 9}{c BT}{hline 68}    diff = mean({res}0{txt}) - mean({res}1{txt})                                      t = {res}  2.6028{txt}Ho: diff = 0                     Satterthwaite's degrees of freedom = {res} 75.6456    {txt}Ha: diff < 0                 Ha: diff != 0                 Ha: diff > 0 Pr(T < t) = {res}0.9944         {txt}Pr(|T| > |t|) = {res}0.0111          {txt}Pr(T > t) = {res}0.0056{txt}{com}. ttest ControlWins, by(MuslimPair) unpaired unequal{txt}Two-sample t test with unequal variances{hline 9}{c TT}{hline 68}   Group{col 10}{c |}{col 16}Obs{col 27}Mean{col 35}Std. Err.{col 47}Std. Dev.{col 59}[95% Conf. Interval]{hline 9}{c +}{hline 68}       0 {c |}{res}{col 12}     49{col 22}  .755102{col 34}  .062069{col 46}  .434483{col 58} .6303039{col 70} .8799001       {txt}1 {c |}{res}{col 12}     35{col 22} .9428571{col 34} .0398075{col 46} .2355041{col 58} .8619587{col 70} 1.023756{txt}{hline 9}{c +}{hline 68}combined {c |}{res}{col 12}     84{col 22} .8333333{col 34} .0409067{col 46} .3749163{col 58} .7519715{col 70} .9146952{txt}{hline 9}{c +}{hline 68}    diff {c |}{res}{col 22}-.1877551{col 34} .0737373{col 58}-.3345796{col 70}-.0409306{txt}{hline 9}{c BT}{hline 68}    diff = mean({res}0{txt}) - mean({res}1{txt})                                      t = {res} -2.5463{txt}Ho: diff = 0                     Satterthwaite's degrees of freedom = {res} 77.1745    {txt}Ha: diff < 0                 Ha: diff != 0                 Ha: diff > 0 Pr(T < t) = {res}0.0064         {txt}Pr(|T| > |t|) = {res}0.0129          {txt}Pr(T > t) = {res}0.9936{txt}{com}. ttest TestWins==ControlWins if ChristianPair==1, unpaired unequal{txt}Two-sample t test with unequal variances{hline 9}{c TT}{hline 68}Variable{col 10}{c |}{col 16}Obs{col 27}Mean{col 35}Std. Err.{col 47}Std. Dev.{col 59}[95% Conf. Interval]{hline 9}{c +}{hline 68}TestWins {c |}{res}{col 12}     49{col 22} .5918367{col 34}  .070941{col 46}  .496587{col 58} .4492003{col 70} .7344732{txt}Contro~s {c |}{res}{col 12}     49{col 22}  .755102{col 34}  .062069{col 46}  .434483{col 58} .6303039{col 70} .8799001{txt}{hline 9}{c +}{hline 68}combined {c |}{res}{col 12}     98{col 22} .6734694{col 34}  .047614{col 46} .4713549{col 58} .5789687{col 70} .7679701{txt}{hline 9}{c +}{hline 68}    diff {c |}{res}{col 22}-.1632653{col 34} .0942613{col 58}-.3504146{col 70}  .023884{txt}{hline 9}{c BT}{hline 68}    diff = mean({res}TestWins{txt}) - mean({res}ControlWins{txt})            